# Copy to .env and fill in real values. Never commit .env.
# On Vercel, set the same names under Project > Settings > Environment Variables
# (.env is not deployed).

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# Set to false ONLY for local development over plain http (e.g. testing from a
# phone on your LAN). Keep true in production behind HTTPS.
SESSION_COOKIE_SECURE=true
SESSION_HOURS=8

# --- Supabase PostgreSQL --------------------------------------------------
# Leave unset to use the local SQLite file (DATABASE_PATH) for development.
# Supabase dashboard > Connect > "Transaction pooler" (port 6543) for Vercel;
# "Session pooler" (port 5432) for the migration scripts run from your PC.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DB_CONNECT_TIMEOUT=10

# --- Supabase Storage (images) --------------------------------------------
# Leave unset to keep images in UPLOAD_FOLDER for development.
# Supabase dashboard > Project Settings > API. The service-role key is a
# SERVER-SIDE SECRET: never put it in HTML/JavaScript or commit it.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# SUPABASE_BUCKET=part-images
# SUPABASE_SIGNED_URL_TTL=3600     (seconds an image link stays valid)
# STORAGE_TIMEOUT=15               (seconds per Storage request)

# On Vercel the app refuses to start without DATABASE_URL and SUPABASE_*.
# Set this only for a throwaway demo whose data may vanish at any time.
# ALLOW_EPHEMERAL_STORAGE=false

# --- Local storage locations (SQLite / local images) ----------------------
# INSTANCE_DIR=/var/lib/trolley-manager
# DATABASE_PATH=/var/lib/trolley-manager/trolley_manager.db
# UPLOAD_FOLDER=/var/lib/trolley-manager/uploads
# BACKUP_FOLDER=/var/backups/trolley-manager
# LOG_FOLDER=/var/log/trolley-manager
# LOG_TO_FILE=true   (default: false on Vercel/AWS Lambda, where logs go to stdout)
BACKUP_KEEP=14

# Upload limits. Default MAX_IMAGE_MB is 4 on Vercel (its request limit is 4.5 MB).
MAX_IMAGE_MB=5
MAX_IMAGE_DIMENSION=1600
# Stored images are recompressed / scaled down (not below 640 px) to fit this.
MAX_STORED_IMAGE_MB=2
MAX_REQUEST_MB=200

# Login rate limiting. Leave RATELIMIT_STORAGE_URI unset: with DATABASE_URL the
# counters are kept in PostgreSQL (shared by all Vercel instances), otherwise
# in memory. A redis:// URI may be set instead.
LOGIN_RATE_LIMIT=5 per minute;30 per hour
# RATELIMIT_STORAGE_URI=memory://

# Set to true when running behind nginx / Caddy / a platform load balancer.
# (Defaults to true on Vercel.)
TRUST_PROXY=false
